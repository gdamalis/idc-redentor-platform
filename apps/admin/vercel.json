{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/content/pdf-worker",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/content/pdf-worker/route.ts": {
      "maxDuration": 60
    }
  }
}
