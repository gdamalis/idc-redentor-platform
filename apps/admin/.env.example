ENVIRONMENT_NAME=local

# --- MongoDB (one connection string per database — ICR-166) ---

# apps/admin reaches TWO databases, each via its own self-contained connection
# string authenticating as its own single-database Atlas user. The DB name rides
# in the URI PATH — there is deliberately no separate DB-name env var. Both URIs
# must set authSource=admin explicitly and maxPoolSize to match this app's
# MongoClient options (10). Neither accessor can read the other's variable.
# See docs/architecture/admin-database.md.
# Do not commit real connection strings here (server-side only, gitignored).

# Congregant PII + admin auth. Path DB must be one of "ministry-admin" (prod),
# "ministry-admin-staging", "ministry-admin-test", "ministry-admin-qa", or
# "ministry-admin-e2e" (non-prod / QA — mirrors .claude/config.json's
# qa.env.*.dbNameAllow), e.g.:
#   mongodb+srv://<host>/ministry-admin?authSource=admin&retryWrites=true&w=majority&maxPoolSize=10
# getAdminDb() fails closed on any other name. Note: the code layer alone no
# longer rejects a prod credential misconfigured to a QA-suffixed name (e.g.
# ministry-admin-test) — the Atlas grant is what enforces that boundary. See
# docs/architecture/admin-database.md.
MONGODB_URI=

# Public-site content (likes, contact) — the admin authors it as a CMS. Reuses
# apps/web's existing website user. Path DB must be one of "website" (prod),
# "website-staging", "website-test", "website-qa", or "website-e2e" (non-prod
# / QA — mirrors .claude/config.json's qa.env.*.dbNameAllow), e.g.:
#   mongodb+srv://<host>/website?authSource=admin&retryWrites=true&w=majority&maxPoolSize=10
# getContentDb() fails closed on any other name.
WEBSITE_MONGODB_URI=

# --- Base URL ---

# Canonical base URL this admin app is hosted on. Set in Vercel for deployed
# environments; only needed locally if a feature needs an absolute URL.
NEXT_PUBLIC_ADMIN_BASE_URL=

# Public church website — linked from /no-access as somewhere useful to go for
# a visitor who was refused admin access. Optional: falls back to the
# production site (https://www.idcredentor.org) in code when unset, so this
# can stay blank in every environment.
NEXT_PUBLIC_WEBSITE_URL=

# --- Firebase — client SDK (browser-safe) ---
# Config values from the Firebase console: Project settings -> General ->
# Your apps -> Web app -> SDK setup and configuration. These are NOT secrets
# (they identify the project to the browser, same as any public Firebase web
# config) but still ship blank here per the repo's names-only convention.
# Read lazily by src/lib/firebase/client.ts — never at import time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase — Admin SDK (server-only service account) ---
# From a service account JSON key: Firebase console -> Project settings ->
# Service accounts -> Generate new private key. SECRET — never commit real
# values. FIREBASE_PRIVATE_KEY is stored with literal "\n" escapes in most env
# stores (Vercel included); src/lib/firebase/admin.ts un-escapes it before
# handing it to the SDK. Read lazily — never at import time (server-only.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Email (Resend — invite + password-reset templates, ICR-127) ---
# Mirrors apps/web's RESEND_API_KEY / FROM_EMAIL — see that app's .env.example.
# Consumed by src/service/mailing/{resend.adapter,mailing.service}.ts (Resend
# only — this app declares no MAIL_PROVIDER/SendGrid) to send the bilingual
# invite + password-reset emails (src/templates/{invite,password-reset}.template.ts).
RESEND_API_KEY=
FROM_EMAIL=

# --- Auth flows: which vars above they consume (ICR-127, no new vars) ---
# - Firebase client SDK (NEXT_PUBLIC_FIREBASE_*): login-form.tsx's Google +
#   email/password sign-in (src/lib/firebase/client.ts).
# - Firebase Admin SDK (FIREBASE_*): session mint/verify/revoke + the
#   password-reset link (src/lib/firebase/admin.ts's getAdminAuth(), used by
#   src/lib/auth/{session,current-user}.ts and the reset Server Action).
# - MONGODB_URI: the invite-gated AdminUser/Invite documents
#   (src/service/{user,invite}.service.ts via getAdminDb()).
# - RESEND_API_KEY / FROM_EMAIL: the invite + password-reset emails (above).
# - NEXT_PUBLIC_ADMIN_BASE_URL: builds the invite link and the Admin-SDK
#   password-reset link's redirect target (both point back at /{locale}/login).
# See docs/architecture/admin-auth.md.

# --- Content platform — site revalidation & publish emails (ICR-195) ---
# Server-only, NO fallback (never reads NEXT_PUBLIC_WEBSITE_URL).
# Staging/Preview: https://staging.idcredentor.org
# Production:      https://www.idcredentor.org
# Non-production deployments (VERCEL_TARGET_ENV !== "production") refuse any
# production website host regardless of what is configured here.
WEBSITE_REVALIDATE_URL=
# Shared secret sent as `x-vercel-reval-key` to <WEBSITE_REVALIDATE_URL>/api/revalidate.
# Holds the same value as apps/web's CONTENTFUL_REVALIDATE_SECRET until decommission.
WEBSITE_REVALIDATE_SECRET=
# Global publish-email switch. OFF unless explicitly set to "true".
# Leave blank / "false" until the post-cutover follow-up ticket turns it on.
CONTENT_PUBLISH_EMAILS=

# --- Content platform — signed preview opener & trial mode (ICR-197) ---
# Server-only shared HMAC-SHA256 secret matching apps/web's CONTENT_PREVIEW_SECRET.
# Never exposed to the browser (never NEXT_PUBLIC_*).
CONTENT_PREVIEW_SECRET=
# Optional override for the preview target website origin. When unset, falls back
# to WEBSITE_REVALIDATE_URL (still server-only and production-host guarded).
WEBSITE_PREVIEW_URL=
# Pre-cutover trial mode banner (shown on all Contenido pages and publish dialogs,
# including production). Active by default until explicitly set to "false" at cutover (ICR-206).
CONTENT_TRIAL_MODE=
