{
  "pkg": "@idcr/web",
  "globalName": "IDCR",
  "projectId": "7329c8ed-3ed2-46c0-bb2c-4f6edd7aca07",
  "shape": "package",
  "srcDir": "src",
  "buildCmd": "npx --yes @tailwindcss/cli@4.1.16 -i .design-sync/ds-styles.css -o apps/web/.ds-css/ds-tailwind.css && rm -rf apps/web/dist/types && (cd apps/web && npx tsc -p tsconfig.json --declaration --emitDeclarationOnly --noEmit false --outDir dist/types)",
  "tsconfig": "../../.design-sync/tsconfig.ds.json",
  "cssEntry": ".ds-css/ds-tailwind.css",
  "extraEntries": ["../../.design-sync/ds-provider.tsx"],
  "provider": {
    "component": "NextIntlClientProvider",
    "props": {
      "locale": "es-AR",
      "messages": {
        "$ref": "dsMessages"
      }
    }
  },
  "overrides": {
    "CreedSection": {
      "cardMode": "column",
      "viewport": "1280x1250"
    },
    "ContactForm": {
      "cardMode": "column",
      "viewport": "1280x1050"
    },
    "Navbar": {
      "cardMode": "single",
      "primaryStory": "Solid"
    },
    "Footer": {
      "cardMode": "column"
    },
    "SubscribeBanner": {
      "cardMode": "column"
    },
    "Toast": {
      "cardMode": "single",
      "primaryStory": "Default"
    },
    "Toaster": {
      "cardMode": "single",
      "primaryStory": "CopyLink"
    },
    "IconCard": {
      "cardMode": "column"
    },
    "LanguageSwitcher": {
      "cardMode": "column"
    }
  },
  "componentSrcMap": {
    "AuthorInfo": "src/components/features/blog-post-details/AuthorInfo.tsx",
    "BibleVerse": "src/components/shared/bible-verse/BibleVerse.tsx",
