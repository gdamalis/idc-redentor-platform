        "../apps/web/src/components/features/our-mission-section/index.ts"
      ],
      "@src/components/features/photo-grid": [
        "../apps/web/src/components/features/photo-grid/index.ts"
      ],
      "@src/components/features/sermon-details": [
        "../apps/web/src/components/features/sermon-details/index.ts"
      ],
      "@src/components/features/sermon-section": [
        "../apps/web/src/components/features/sermon-section/index.ts"
      ],
      "@src/components/shared/bible-verse": [
        "../apps/web/src/components/shared/bible-verse/index.ts"
