{
  // Bundle-time module resolution for design-sync (cfg.tsconfig).
  //
  // lib/bundle.mjs#tsconfigPathsPlugin builds its esbuild resolve filter from
  // whatever prefixes appear below — it is NOT hardcoded to "@/"-style aliases.
  // That lets bare Next framework imports be redirected to local shims with no
  // fork of the converter.
  //
  // ORDER MATTERS: the plugin returns the FIRST matching rule, so every exact
  // entry must stay above the "@src/*" wildcard.
  //
  // The long block of directory -> index.ts entries is not boilerplate: the
  // plugin resolves by trying extensions ['', '.ts', '.tsx', ...] in order, and
  // existsSync() is TRUE for a directory, so a bare directory import (e.g.
  // "@src/components/ui/dropdown") resolves to the DIRECTORY and esbuild fails
  // with "Cannot read file ...: is a directory". The app's own components import
  // these dirs, so this must be fixed in the resolver, not by editing product
  // source. Regenerate with the snippet in .design-sync/NOTES.md when a
  // component directory is added.
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "framer-motion": ["./shims/framer-motion.tsx"],
      "next/image": ["./shims/next-image.tsx"],
      "@src/i18n/routing": ["./shims/i18n-routing.tsx"],
      "@src/service/contact.service": ["./shims/contact-services.tsx"],
      "@src/service/contact-form-email.service": [
        "./shims/contact-services.tsx"
      ],
      "@src/components/features/blog-post-details": [
        "../apps/web/src/components/features/blog-post-details/index.ts"
      ],
      "@src/components/features/blog-section": [
        "../apps/web/src/components/features/blog-section/index.ts"
      ],
      "@src/components/features/community-event": [
        "../apps/web/src/components/features/community-event/index.ts"
      ],
      "@src/components/features/component-cta": [
        "../apps/web/src/components/features/component-cta/index.ts"
      ],
      "@src/components/features/contact-form": [
        "../apps/web/src/components/features/contact-form/index.ts"
      ],
      "@src/components/features/creed-section": [
        "../apps/web/src/components/features/creed-section/index.ts"
      ],
      "@src/components/features/info-community": [
        "../apps/web/src/components/features/info-community/index.ts"
